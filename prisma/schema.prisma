datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Prompt {
  id        Int      @id @default(autoincrement())
  name      String
  template  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotArticle {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String
  category    String
  cover       String?
  wxid        String?
  mpNickname  String?
  pubTime     String?
  publishType String?
  position    Int?
  isOriginal  String?
  readNum     Int?
  zanNum      Int?
  avg         Float?
  hot         Float?
  fans        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
